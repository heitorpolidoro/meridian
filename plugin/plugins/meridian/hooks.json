{
  "meridian-running-flag": {
    "PreToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "__MERIDIAN_PLUGIN_DIR__/scripts/running-flag.sh pre",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "__MERIDIAN_PLUGIN_DIR__/scripts/allow-meridian.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "__MERIDIAN_PLUGIN_DIR__/scripts/running-flag.sh post",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "__MERIDIAN_PLUGIN_DIR__/scripts/running-flag.sh stop",
        "timeout": 10
      }
    ]
  }
}
