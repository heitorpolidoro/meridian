FROM node:24-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install gemini-cli globally
RUN npm install -g @google/gemini-cli

# Copy necessary files for installation
COPY package*.json ./
RUN npm install

# Copy source code (respecting .dockerignore)
COPY . .

# Ensure sensitive local data is cleared if copied by mistake
RUN rm -f .env* .secrets.baseline

# Expose Vite (5173) and Server (3000)
EXPOSE 5173 3000

ENV NODE_ENV=development

# Run concurrently (Vite + Server with watch)
CMD ["npm", "run", "dev"]
