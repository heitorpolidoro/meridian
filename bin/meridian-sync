#!/usr/bin/env python3

import os
import sys
import json
import shutil
import argparse
from pathlib import Path

# ANSI Colors for output
RED = '\033[0;31m'
GREEN = '\033[0;32m'
YELLOW = '\033[1;33m'
BLUE = '\033[0;34m'
CYAN = '\033[0;36m'
NC = '\033[0m'

def print_color(message, color=NC):
    print(f"{color}{message}{NC}")

def main():
    print_color("=== Meridian Agent & Skill Factory ===", BLUE)

    # Resolve paths
    script_path = Path(__file__).resolve()
    source_dir = script_path.parent.parent
    target_dir = Path.cwd()

    print_color(f"Source: {YELLOW}{source_dir}{NC}")
    print_color(f"Target: {YELLOW}{target_dir}{NC}")

    # Parse Arguments
    parser = argparse.ArgumentParser(description="Sync Meridian standards and generate agents/skills.")
    parser.add_argument('--add-expert', nargs='+', help="Add expert roles (e.g., python, go, elixir)")
    args = parser.parse_args()

    extra_experts = []
    if args.add_expert:
        roles_source_dir = source_dir / ".meridian" / "roles"
        available_roles = sorted([f.stem for f in roles_source_dir.glob("*.md")])
        
        for expert_input in args.add_expert:
            direct_file = roles_source_dir / f"{expert_input}.md"
            expert_file = roles_source_dir / f"{expert_input}-expert.md"
            
            if direct_file.exists():
                extra_experts.append(expert_input)
            elif expert_file.exists():
                extra_experts.append(f"{expert_input}-expert")
            else:
                print_color(f"\nError: Expert '{expert_input}' not found in roles.", RED)
                print_color(f"Available roles: {', '.join(available_roles)}", CYAN)
                sys.exit(1)

    print_color("\n[1/3] Preparing Meridian Infrastructure...", BLUE)
    dirs_to_create = [
        target_dir / ".meridian" / "core",
        target_dir / ".meridian" / "roles",
        target_dir / ".gemini" / "agents",
        target_dir / ".gemini" / "skills"
    ]
    for d in dirs_to_create:
        d.mkdir(parents=True, exist_ok=True)
    
    print_color("\n[2/3] Syncing Core Standards & Roles...", BLUE)
    
    # Sync Core Standards
    source_core = source_dir / ".meridian" / "core"
    target_core_dir = target_dir / ".meridian" / "core"
    if source_core.exists() and source_core.resolve() != target_core_dir.resolve():
        for item in source_core.iterdir():
            if item.is_file():
                shutil.copy2(item, target_core_dir / item.name)
        print_color("  ✅ Core Standards synced.", GREEN)

    # Sync Roles
    source_roles = source_dir / ".meridian" / "roles"
    target_roles_dir = target_dir / ".meridian" / "roles"
    if source_roles.exists() and source_roles.resolve() != target_roles_dir.resolve():
        for item in source_roles.iterdir():
            if item.is_file():
                shutil.copy2(item, target_roles_dir / item.name)
        print_color("  ✅ Roles synced.", GREEN)

    # agents.json Logic
    source_agents_file = source_dir / ".meridian" / "agents.json"
    target_agents_file = target_dir / ".meridian" / "agents.json"

    added_ids = []
    if source_agents_file.exists():
        core_names = [
            "software-architect", "software-engineer", "product-manager", 
            "quality-assurance", "devsecops", "site-reliability-engineer", 
            "staff-engineer", "engineering-manager"
        ]
        allowed_names = set(core_names + extra_experts)

        with open(source_agents_file, 'r') as f:
            source_agents = json.load(f)

        if target_agents_file.exists():
            try:
                with open(target_agents_file, 'r') as f:
                    target_agents = json.load(f)
            except:
                target_agents = []
            
            existing_ids = {a.get('id') for a in target_agents}
            agents_to_add = [a for a in source_agents if a.get('name') in allowed_names and a.get('id') not in existing_ids]
            
            if agents_to_add:
                added_ids = [a.get('id') for a in agents_to_add]
                target_agents.extend(agents_to_add)
                with open(target_agents_file, 'w') as f:
                    json.dump(target_agents, f, indent=2)
                print_color(f"  ✅ Added to agents.json: {', '.join(added_ids)}", GREEN)
            else:
                print_color("  ℹ️ agents.json up to date.", NC)
        else:
            core_agents = [a for a in source_agents if a.get('name') in allowed_names]
            added_ids = [a.get('id') for a in core_agents]
            with open(target_agents_file, 'w') as f:
                json.dump(core_agents, f, indent=2)
            print_color(f"  ✅ agents.json initialized.", GREEN)

    print_color("\n[3/3] Generating Triggers (Agents & Skills)...", BLUE)
    if not target_agents_file.exists():
        print_color(f"  ⚠️ Target agents.json not found.", YELLOW)
    else:
        # Clear skills directory
        skills_dir = target_dir / ".gemini" / "skills"
        if skills_dir.exists():
            shutil.rmtree(skills_dir)
        skills_dir.mkdir(parents=True, exist_ok=True)

        try:
            with open(target_agents_file, 'r') as f:
                agents = json.load(f)
        except (json.JSONDecodeError, IOError) as e:
            print_color(f"  ❌ Error reading {target_agents_file}: {e}", RED)
            sys.exit(1)

        roles_map = {}
        for agent in agents:
            name = agent.get('name')
            aid = agent.get('id')
            role_desc = agent.get('role', 'Specialized Meridian Agent')
            if not name or not aid: continue
            if name not in roles_map:
                roles_map[name] = {"ids": [], "role": role_desc}
            roles_map[name]["ids"].append(aid)

        for name, data in roles_map.items():
            role_desc = data["role"]
            ids = data["ids"]
            for aid in ids:
                agent_file = target_dir / ".gemini" / "agents" / f"{aid}.md"
                agent_content = f"""---
name: {aid}
description: "{role_desc}"
---

# Agent Bootstrapping

Your complete identity and roles are defined at:
@../../.meridian/roles/{name}.md

**Critical Instruction:** 
Before performing anything, you MUST read and fully load the file above to understand your responsibility and global standards.
"""
                with open(agent_file, 'w') as f:
                    f.write(agent_content)

            is_new_role = any(aid in added_ids for aid in ids)
            if is_new_role:
                print_color(f"  ✅ {name.title()} ({', '.join(ids)}) - agents added", GREEN)

        # Sync skills from .meridian/skills
        source_custom_skills = source_dir / ".meridian" / "skills"
        if source_custom_skills.exists():
            for skill_item in source_custom_skills.iterdir():
                if skill_item.is_dir():
                    target_skill_path = skills_dir / skill_item.name
                    if target_skill_path.exists():
                        shutil.rmtree(target_skill_path)
                    shutil.copytree(skill_item, target_skill_path)
                    print_color(f"  ✅ Skill '{skill_item.name}' synced.", GREEN)

                    # Generate .skill package
                    package_script = source_dir / "node_modules" / "@google" / "gemini-cli" / "bundle" / "builtin" / "skill-creator" / "scripts" / "package_skill.cjs"
                    if package_script.exists():
                        os.system(f"node {package_script} {target_skill_path} {target_dir} > /dev/null 2>&1")
                        print_color(f"  📦 Portable package '{skill_item.name}.skill' generated.", CYAN)

        print_color(f"\nSuccessfully synced {len(roles_map)} roles.", GREEN)

    print_color("\n=== Synchronization & Generation Complete! ===", GREEN)

if __name__ == "__main__":
    main()
